from cryptography.hazmat.primitives.ciphers.aead import ChaCha20Poly1305
import os

# 1. Configuración de datos
mensaje = "Escuela Militar de Ingenieria"
key = ChaCha20Poly1305.generate_key()
nonce = os.urandom(12)

# 2. Proceso de Cifrado
cipher = ChaCha20Poly1305(key)
datos_cifrados = cipher.encrypt(nonce, mensaje.encode(), None)

print(f"Texto Original: {mensaje}")
print(f"Cifrado (Hex): {datos_cifrados.hex()}")

# 3. Proceso de Descifrado (Lógica de recuperación)
decipher = ChaCha20Poly1305(key)
texto_final = decipher.decrypt(nonce, datos_cifrados, None).decode()

print(f"Texto Recuperado: {texto_final}")
